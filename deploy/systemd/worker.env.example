# Copy to /etc/rcptto/worker-<instance>.env, one file per egress IP.
# Mode 0640, owner root:rcptto — it holds the shared control-plane token.

# Must match the identity id in the control plane's RCPTTO_WORKERS list.
# Reputation is attributed to this id, so a mismatch credits the wrong IP —
# the control plane refuses to use an agent whose reported id disagrees.
RCPTTO_WORKER_ID=eg_vps1a

# Listen address. On a host running two agents, give each its own port.
RCPTTO_WORKER_ADDR=:9090

# The public IP this agent must send from. Required on a multi-IP host: without
# it the OS picks the source address and probes can leave via the wrong identity.
RCPTTO_WORKER_IP=203.0.113.10

# Shared secret; identical on every agent and on the control plane.
# Generate once: openssl rand -base64 32
RCPTTO_WORKER_TOKEN=

# The hostname presented to destination mail servers. Its forward DNS must
# resolve to RCPTTO_WORKER_IP, and that IP's PTR must resolve back to it.
# Mismatched HELO/PTR is the fastest way to be blocked, whatever the volume.
RCPTTO_HELO=mx1.example.com
RCPTTO_MAIL_FROM=verify@example.com

# Optional, reported to the control plane for routing diversity.
RCPTTO_WORKER_REGION=eu
RCPTTO_WORKER_ASN=AS51167
