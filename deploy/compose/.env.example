# Copy to .env and fill in. Never commit the filled-in .env.
#
#   cp deploy/compose/.env.example deploy/compose/.env

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=rcptto
POSTGRES_DB=rcptto
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- SMTP identity (critical for deliverability) ----------------------------
# RCPTTO_HELO must be a real hostname that resolves to this server's public IP,
# and that IP's PTR (reverse DNS) record must resolve back to this hostname.
# Mismatched or generic HELO/PTR is one of the fastest ways to get an IP
# flagged, independent of volume. Set the PTR record in your VPS provider's
# control panel (Hetzner, OVH, etc.).
RCPTTO_HELO=verify.example.com
RCPTTO_MAIL_FROM=verify@example.com

# --- Dashboard auth ---------------------------------------------------------
RCPTTO_DASHBOARD_USER=admin
# Generate: openssl rand -base64 24
RCPTTO_DASHBOARD_PASSWORD=
# Generate: openssl rand -base64 32
# Keeps dashboard sessions valid across restarts. If empty, a random secret is
# generated at startup and every restart logs everyone out.
RCPTTO_SESSION_SECRET=
# Set to true once TLS terminates in front of the server (recommended).
RCPTTO_SECURE_COOKIE=false

# --- JSON API ---------------------------------------------------------------
# Comma-separated keys required in the X-API-Key header for /v1/*.
# Leave empty to leave the JSON API unauthenticated (localhost-only setups).
RCPTTO_API_KEYS=

# --- Verification behavior --------------------------------------------------
RCPTTO_DETECT_CATCHALL=true

# Per-destination probe pacing. These cap how fast any ONE mail server is
# probed, which is what stops a bulk job concentrated on a single domain from
# hammering that domain's MX. Raising them increases the risk of being blocked.
RCPTTO_PROBE_RATE=1
RCPTTO_PROBE_BURST=5
# Comma-separated DNSBL zones to audit egress IPs against, e.g. zen.spamhaus.org
# Note: public DNSBLs refuse queries from shared/public resolvers — use your own
# resolver or a proper data feed in production.
RCPTTO_DNSBL_ZONES=
