# Copy to worker.env on each agent host and fill in that host's values.
# One entry per egress IP; a two-IP box uses both.

# Shared secret, identical on every agent and on the control plane.
# Generate once: openssl rand -base64 32
RCPTTO_WORKER_TOKEN=

# --- first IP ---------------------------------------------------------------
AGENT_A_ID=eg_vps1a
AGENT_A_ADDR=:9090
AGENT_A_IP=203.0.113.10
AGENT_A_HELO=mx1.example.com
AGENT_A_MAIL_FROM=verify@example.com

# --- second IP --------------------------------------------------------------
AGENT_B_ID=eg_vps1b
AGENT_B_ADDR=:9091
AGENT_B_IP=203.0.113.11
AGENT_B_HELO=mx2.example.com
AGENT_B_MAIL_FROM=verify@example.com

# Optional, reported to the control plane for routing diversity.
AGENT_REGION=eu
AGENT_ASN=AS51167
